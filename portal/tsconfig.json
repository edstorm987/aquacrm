{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/engines/*": [
        "./src/engines/*"
      ],
      "@built-ins/*": [
        "./src/built-ins/*"
      ],
      "@aqua/plugin-affiliates": [
        "./src/built-ins/modules/affiliates/index.ts"
      ],
      "@aqua/plugin-affiliates/server": [
        "./src/built-ins/modules/affiliates/src/server/index.ts"
      ],
      "@aqua/plugin-affiliates/types": [
        "./src/built-ins/modules/affiliates/src/lib/aquaPluginTypes.ts"
      ],
      "@aqua/plugin-affiliates/*": [
        "./src/built-ins/modules/affiliates/src/*"
      ],
      "@aqua/plugin-agency-finance": [
        "./src/built-ins/modules/agency-finance/index.ts"
      ],
      "@aqua/plugin-agency-finance/server": [
        "./src/built-ins/modules/agency-finance/src/server/index.ts"
      ],
      "@aqua/plugin-agency-finance/types": [
