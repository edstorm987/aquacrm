      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "*.ts",
    "*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev-3032/types/**/*.ts",
    ".next-dev-3032/dev/types/**/*.ts",
    ".next-dev-turbo-3032/types/**/*.ts",
    ".next-dev-turbo-3032/dev/types/**/*.ts",
    ".next-archive/types/**/*.ts",
    ".next-archive/dev/types/**/*.ts",
    ".next-build-verify/types/**/*.ts",
    ".next-build-verify/dev/types/**/*.ts",
    ".next-csp/types/**/*.ts",
    ".next-csp/dev/types/**/*.ts",
    ".next-build-verify2/types/**/*.ts",
    ".next-build-verify2/dev/types/**/*.ts",
    ".next-journey/types/**/*.ts",
    ".next-journey/dev/types/**/*.ts",
    ".next-journey-build/types/**/*.ts",
    ".next-journey-build/dev/types/**/*.ts",
    ".next-hb/types/**/*.ts",
    ".next-hb/dev/types/**/*.ts",
    ".next-fin/types/**/*.ts",
    ".next-fin/dev/types/**/*.ts",
    ".next-f2/types/**/*.ts",
    ".next-f2/dev/types/**/*.ts",
    ".next-look/types/**/*.ts",
    ".next-look/dev/types/**/*.ts",
    ".next-look-turbo/types/**/*.ts",
    ".next-look-turbo/dev/types/**/*.ts",
    ".next-belt/types/**/*.ts",
    ".next-belt/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-looploop-turbo/types/**/*.ts",
    ".next-looploop-turbo/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_attic",
    "src/_attic",
    "scripts",
    "src/**/__smoke__"
  ]
}
