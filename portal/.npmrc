# Vendored local plugins (`@aqua/plugin-*`) install from `plugins/*`.
# Turbopack 16 doesn't follow npm's default symlinks for those, so we
# tell npm to copy each package into `node_modules` instead.
# When iterating on plugin source, re-run `npm install` to refresh.
install-links=true

# Railway/self-host: the app installs with --legacy-peer-deps (see vercel.json).
legacy-peer-deps=true
