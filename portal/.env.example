# Aqua portal — environment variables.
#
# Copy to .env.local for local dev. Production deploys MUST set
# PORTAL_SESSION_SECRET to a long random value (≥32 chars).
#
# ─── Taxonomy ────────────────────────────────────────────────────────────────
# Two kinds of secrets coexist in this stack — keep them separated:
#
#   1. Per-deployment (THIS FILE): infrastructure-level — DB URL, session
#      key, observability DSN, Vercel API token for domain attach. One
#      value per Vercel project. Read from `process.env`.
#
#   2. Per-client (NOT THIS FILE): customer-specific settings such as
#      payment destinations, support details, service plans, and portal
#      identity. These are managed from each client's portal editor.
#
# Why split: AquaCRM is multi-tenant — one Vercel deploy
# serves the agency and every client. Per-client values in env would either
# have to live alongside hundreds of other tenants' secrets in one
# place (security mess) or force one Vercel project per tenant (defeats
# pool-model multi-tenancy from architecture §1). Per-install config
# keeps tenant secrets scoped + rotatable without redeploys.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random secret used to HMAC-sign the session cookie (`lk_session_v1`).
# Local dev falls back to a fixed dev secret if unset; production logs
# a warning at every sign-in until set. Generate via
# `node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'`.
PORTAL_SESSION_SECRET=

# Separate AES-256 key for passwords stored in the Development Knowledge
# Vault. Required before production users can save shared logins. Generate
# independently from the session secret and keep it server-only.
PORTAL_VAULT_ENCRYPTION_KEY=

# Founder seed (T1 R024). Provisions the agency-owner Ed signs in with
# on first boot. Behaviour:
#   - FOUNDER_PASSWORD missing → seed is skipped (warning logged in dev,
#     fail-closed startup error in production).
#   - Production guard refuses seed when password < 12 chars OR email is
#     the dev default. Rotate before any public flip — chapter #124 ship gate.
#   - Honors validatePassword (≥8 chars in dev, ≥12 in production).
FOUNDER_EMAIL=edwardhallam07@gmail.com
FOUNDER_PASSWORD=
FOUNDER_AGENCY_NAME=AquaOasis-Web

# ─── Storage ─────────────────────────────────────────────────────────────────
# Backend selector. "file" persists to .data/portal-state.json for isolated
# development only. Production uses Supabase when its server credentials are
# configured. Set this explicitly in Vercel so readiness and operations agree.
PORTAL_BACKEND=supabase

# Optional datastore namespace. Leave unset in production to use the canonical
# AquaCRM state row. Release smoke tests set a temporary key so test clients
# can never enter the live agency datastore.
PORTAL_STATE_KEY=

# Postgres connection (T1 R7). Required when PORTAL_BACKEND=postgres.
# Cloud providers (Neon / Supabase / Vercel Postgres) auto-enable TLS.
# DATABASE_URL=postgres://user:pass@host:5432/aqua_portal?sslmode=require
# PORTAL_PG_POOL_MAX=10              # default 10
# PORTAL_PG_IDLE_MS=30000            # default 30s
# PORTAL_PG_CONNECT_MS=10000         # default 10s

# Durable private customer uploads. New files use the private Supabase bucket;
# its service-role key remains server-only. The public bucket is for approved
# website media only. Legacy Vercel Blob credentials remain readable so old
# records can be migrated without breaking downloads.
NEXT_PUBLIC_SUPABASE_PUBLIC_BUCKET=aquacrm-public
NEXT_PUBLIC_SUPABASE_UPLOAD_BUCKET=aquacrm-uploads
# Legacy compatibility only:
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=

# Optional KV (Upstash REST) backend — alternative to Postgres.
# PORTAL_KV_URL=
# PORTAL_KV_TOKEN=

# ─── Security mode ───────────────────────────────────────────────────────────
# "strict" enforces session checks on /portal/*. Unset / "dev" bypasses
# auth so the dev server is browsable without sign-in. Leave at "strict"
# in any non-developer environment.
NEXT_PUBLIC_PORTAL_SECURITY=dev

# ─── Origin ──────────────────────────────────────────────────────────────────
# Public-facing portal origin. Used by /embed/login back-link, the
# milesymedia static front-door's <meta name="aqua-portal-base">, and
# the per-client portal API proxy back to the shared portal.
NEXT_PUBLIC_PORTAL_BASE_URL=https://aqua-crm.com
NEXT_PUBLIC_MILESYMEDIA_WEBSITE_URL=https://milesymedia.com
NEXT_PUBLIC_AQUAOASIS_URL=https://aquaoasis-web.com
NEXT_PUBLIC_ZIMANTE_URL=https://zimante-group.com

# ─── Customer portal access ─────────────────────────────────────────────────
# Bespoke customer portals stay in their own repositories and request a
# short-lived signed Aqua access URL from the server-to-server session API.
# The optional embed URL supports a compact account summary inside a custom
# portal, while the primary URL opens the full Aqua workspace in a new tab.
# Never expose either value through NEXT_PUBLIC_* or browser-side code.
#
# Shared Bearer token sent by trusted customer-portal servers to:
# POST /api/v1/embed/sessions
AQUA_EMBED_API_TOKEN=
#
# Independent HMAC secret used to sign short-lived access tokens. Use at least
# 32 random characters and do not reuse PORTAL_SESSION_SECRET.
AQUA_EMBED_SIGNING_SECRET=

# Optional backend pointer for future API split. Unused today.
# PORTAL_BACKEND_URL=https://api.milesymedia.com

# ─── Custom domains (T6 R1) ──────────────────────────────────────────────────
# Used by @aqua/plugin-domains to attach client domains to per-client
# Vercel projects via the Vercel REST API. Plugin returns a clear
# "not configured" error when these are unset; the manual-DNS runbook
# (chapter 04-deployment-domains-observability.md) still works without
# them. Token scope: domain-attach access on the team that owns the
# per-client projects.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxx       # optional; omit for personal scope

# Private client-repository publishing. Use a fresh fine-grained token with
# permission to create and write repositories for this account or organisation.
# The token is server-only and is never written into a generated Git remote.
# GITHUB_TOKEN=
# GITHUB_OWNER=edstorm987

# ─── Observability (T6 R1) ───────────────────────────────────────────────────
# Sentry DSN for server-side error capture. Unset = no-op (the wrapper
# at src/lib/server/observability.ts is safe to call without a DSN).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production              # tag every event; default = NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE=0.1              # 0.0–1.0, default 0 (no traces)
#
# Public DSN for client-side capture (only set if you want browser
# errors collected). Defaults to no-op when unset.
# NEXT_PUBLIC_SENTRY_DSN=
#
# Vercel Analytics is opt-in via `@vercel/analytics` — no env var
# required; Vercel auto-injects VERCEL_ANALYTICS_ID at runtime when
# enabled in the dashboard (Project → Analytics → Web).

# ─── System email ────────────────────────────────────────────────────────────
# One server-only Resend key delivers security-critical account email and
# public enquiry notifications. Verify every production FROM domain in Resend.
RESEND_API_KEY=
MILESYMEDIA_FROM_EMAIL=
MILESYMEDIA_FROM_NAME=Milesymedia
MILESYMEDIA_REPLY_TO=
MILESYMEDIA_SUPPORT_EMAIL=

# Public enquiry notifications. The enquiry is committed to Supabase before
# delivery is attempted, so an email-provider outage never loses a submission.
# Verify the sender domain in Resend before using a production FROM address.
ENQUIRY_NOTIFY_TO=edwardhallam07@gmail.com
ENQUIRY_EMAIL_FROM=AquaCRM enquiries <enquiries@aqua-crm.com>

# ─── Stripe billing ──────────────────────────────────────────────────────
# Server-side Stripe secret for real Checkout payments and subscriptions.
# Register the webhook endpoint below in Stripe Workbench, replacing the
# agency id with the live Milesymedia agency id:
# /api/portal/leads-pipeline/commercial/stripe-webhook?agencyId=<agency-id>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Private business assistant ───────────────────────────────────────────
# Server-side only. ChatGPT subscriptions cannot be used as API credentials;
# create an API key in the OpenAI Platform and keep it out of NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5-mini

# ─── Model-independent assistant gateway ──────────────────────────────────
# Read-only API for Custom GPT Actions, AI skills, or another trusted model.
# Generate a long random token, keep it server-side, and send it to clients
# only as an Authorization: Bearer header. Never prefix it with NEXT_PUBLIC_.
# Example generation command: openssl rand -hex 32
MILESYMEDIA_ASSISTANT_API_TOKEN=
MILESYMEDIA_ASSISTANT_AGENCY_ID=milesymedia
MILESYMEDIA_SUPPORT_PHONE=
MILESYMEDIA_SUPPORT_WHATSAPP_URL=

# ─── Google OAuth (T1 R9 — chapter 04-google-oauth-activation) ───────────────
# Optional. All three unset → `isGoogleOAuthConfigured()` returns false →
# the "Continue with Google" button stays hidden + the start/callback
# routes 404. Login still works via password / magic-link without these.
#
# To enable:
#   1. Google Cloud Console → select / create project.
#   2. APIs & Services → Credentials → Create Credentials →
#      OAuth 2.0 Client ID → Application type: Web application.
#   3. Authorised redirect URI:
#        <NEXT_PUBLIC_PORTAL_BASE_URL>/api/auth/oauth/google/callback
#      e.g. local dev: http://localhost:3032/api/auth/oauth/google/callback
#      e.g. prod:      https://aqua-crm.com/api/auth/oauth/google/callback
#   4. Copy the Client ID + Client Secret into the two vars below.
#   5. (Optional) override the redirect URI explicitly via
#      GOOGLE_OAUTH_REDIRECT_URI; otherwise it's derived from
#      NEXT_PUBLIC_PORTAL_BASE_URL at request time.
#
# GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_OAUTH_REDIRECT_URI=https://aqua-crm.com/api/auth/oauth/google/callback
# Comma-separated specialist website origins allowed to submit enquiries.
# Localhost origins are accepted automatically outside production.
PUBLIC_BRAND_ORIGINS=https://zimante-group.com,https://milesymedia.com,https://aquaoasis-web.com,https://edward-hallam.com
